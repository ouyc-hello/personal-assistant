# Copy to .env locally. Never commit the copied file.
PA_APP_ENV=development
PA_LLM_PROVIDER=fake
PA_LLM_MODEL=
PA_EMBEDDING_PROVIDER=fake
PA_EMBEDDING_MODEL=text-embedding-3-small
PA_EMBEDDING_DIMENSION=1536
PA_OPENAI_API_KEY=

# Container images are explicit for reproducible local development.
PA_POSTGRES_IMAGE=pgvector/pgvector:pg16
PA_MILVUS_IMAGE=milvusdb/milvus:v2.4.4
PA_ETCD_IMAGE=quay.io/coreos/etcd:v3.5.5
PA_MINIO_IMAGE=minio/minio:RELEASE.2024-06-13T22-53-53Z
PA_NEO4J_IMAGE=neo4j:5-community

# PostgreSQL is the business source of truth; pgvector stores memory embeddings.
PA_POSTGRES_USER=assistant
PA_POSTGRES_DB=assistant
PA_POSTGRES_PASSWORD=
PA_DATABASE_URL=postgresql+psycopg://assistant:SET_THE_SAME_PASSWORD@localhost:5432/assistant

# Milvus stores document chunk embeddings.
PA_MINIO_ROOT_USER=
PA_MINIO_ROOT_PASSWORD=
PA_MILVUS_URI=http://localhost:19530
PA_MILVUS_TOKEN=
PA_MILVUS_COLLECTION=knowledge_chunks

# Neo4j stores entities and relationships for Graph RAG.
PA_NEO4J_URI=bolt://localhost:7687
PA_NEO4J_USER=neo4j
PA_NEO4J_PASSWORD=
PA_NEO4J_DATABASE=neo4j

PA_DEFAULT_USER_ID=local-user
PA_MAX_GRAPH_STEPS=5
